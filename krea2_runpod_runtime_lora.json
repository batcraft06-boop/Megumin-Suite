{
  "1": {
    "inputs": { "unet_name": "krea2_turbo_fp8_scaled.safetensors", "weight_dtype": "default" },
    "class_type": "UNETLoader",
    "_meta": { "title": "UNET Loader - Krea2 Turbo FP8" }
  },
  "2": {
    "inputs": {
      "seed": "%seed%", "steps": "%steps%", "cfg": "%scale%", "sampler_name": "%sampler%", "scheduler": "%scheduler%", "denoise": "%denoise%",
      "model": ["22", 0], "positive": ["6", 0], "negative": ["8", 0], "latent_image": ["10", 0]
    },
    "class_type": "KSampler",
    "_meta": { "title": "KSampler" }
  },
  "3": {
    "inputs": { "samples": ["2", 0], "vae": ["4", 0] },
    "class_type": "VAEDecode",
    "_meta": { "title": "VAE Decode" }
  },
  "4": {
    "inputs": { "vae_name": "qwen_image_vae.safetensors" },
    "class_type": "VAELoader",
    "_meta": { "title": "VAE Loader" }
  },
  "5": {
    "inputs": { "filename_prefix": "ComfyUI", "images": ["3", 0] },
    "class_type": "SaveImage",
    "_meta": { "title": "Save Image" }
  },
  "6": {
    "inputs": { "text": ["26", 0], "clip": ["22", 1] },
    "class_type": "CLIPTextEncode",
    "_meta": { "title": "Positive Prompt" }
  },
  "8": {
    "inputs": { "conditioning": ["6", 0] },
    "class_type": "ConditioningZeroOut",
    "_meta": { "title": "Negative (Zero Out)" }
  },
  "10": {
    "inputs": { "width": "%width%", "height": "%height%", "batch_size": 1 },
    "class_type": "EmptyLatentImage",
    "_meta": { "title": "Empty Latent Image" }
  },
  "13": {
    "inputs": { "clip_name": "qwen3vl_4b_fp8_scaled.safetensors", "type": "krea2", "device": "default" },
    "class_type": "CLIPLoader",
    "_meta": { "title": "CLIP Loader - Krea2" }
  },
  "22": {
    "inputs": {
      "lora_01": "%lora1%", "strength_01": "%lorawt1%",
      "lora_02": "%lora2%", "strength_02": "%lorawt2%",
      "lora_03": "%lora3%", "strength_03": "%lorawt3%",
      "lora_04": "%lora4%", "strength_04": "%lorawt4%",
      "model": ["1", 0], "clip": ["13", 0]
    },
    "class_type": "MeguminRuntimeLoraStack",
    "_meta": { "title": "Megumin Runtime LoRA Stack" }
  },
  "26": {
    "inputs": {
      "ai_text": "%ai_text%", "fallback_text": "%prompt%", "model": "%nanogpt_model%", "api_key": "%nanogpt_api_key%",
      "endpoint": "https://nano-gpt.com/api/v1/chat/completions",
      "system_prompt": "%nanogpt_system%",
      "temperature": "%nanogpt_temperature%", "max_tokens": 500, "timeout_seconds": 120, "fallback_on_error": true,
      "identity_suffix": "%krea_identity_suffix%"
    },
    "class_type": "MeguminNanoGPTText",
    "_meta": { "title": "Megumin NanoGPT Text" }
  }
}
